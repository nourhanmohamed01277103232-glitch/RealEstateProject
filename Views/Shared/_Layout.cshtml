<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
  <meta name="viewport" content="width=1280" />
    <title>@ViewData["Title"] - رواسي للتطوير العقاري</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ====== الشريط العلوي الشفاف ====== -->
    <div class="top-bar">
        <!-- رقم التليفون على الشمال -->
        <a href="tel:01104232214" class="top-phone">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
            </svg>
            <span class="top-phone-number">01104232214</span>
        </a>

        <!-- واتساب على اليمين -->
        <a href="https://wa.me/201104232214" target="_blank" rel="noopener" class="top-whatsapp" title="واتساب">
            <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 24 24" fill="#25D366">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
        </a>
    </div>

    <!-- ====== قائمة عائمة على الجنب ====== -->
    <div class="floating-menu">
        <a asp-controller="Home" asp-action="Index" title="الرئيسية">🏠</a>
        <a asp-controller="Booking" asp-action="Create" title="احجز الآن">📝</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="#" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" title="لوحة التحكم">☰</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" title="تسجيل الدخول">🔒</a>
        }
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="offcanvas offcanvas-end" tabindex="-1" id="adminSidebar">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title">لوحة التحكم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column gap-2">
                <span class="text-muted mb-2">
                    مرحباً، @User.Identity.Name
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-danger">أدمن</span>
                    }
                    else
                    {
                        <span class="badge bg-info">شركة</span>
                    }
                </span>
                <a class="nav-link" asp-controller="Bookings" asp-action="Index">📋 الحجوزات</a>
                <a class="nav-link" asp-controller="Properties" asp-action="Index">🏢 الوحدات</a>
                <a class="nav-link" asp-controller="Ledger" asp-action="Index">دفتر الأستاذ</a>
                <a class="nav-link" asp-controller="Partners" asp-action="Index">الشركاء</a>
                <a class="nav-link" asp-controller="CapitalMovements" asp-action="Index">حركات رأس المال</a>
                <a class="nav-link" asp-controller="Expenses" asp-action="Index">المصروفات</a>
                <a class="nav-link" asp-controller="Projects" asp-action="Index">المشاريع</a>
                <hr />
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">تسجيل خروج</button>
                </form>
            </div>
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <!-- ====== الفوتر ====== -->
    <footer class="site-footer text-center py-5 mt-5">
        <img src="~/images/logo.jpg?v=2" alt="رواسي للتطوير العقاري" class="footer-logo mb-3" style="height:100px;" />
        <h4 class="fw-bold text-white mb-3">رواسي للتطوير العقاري</h4>

        <div class="d-flex justify-content-center gap-3 mb-3 flex-wrap">
            <a class="btn btn-success btn-sm px-4" href="https://wa.me/201104232214" target="_blank" rel="noopener">واتساب - خط 1</a>
            <a class="btn btn-success btn-sm px-4" href="https://wa.me/201104232291" target="_blank" rel="noopener">واتساب - خط 2</a>
        </div>
        <p class="mb-1">نحن هنا لمساعدتك في العثور على منزل أحلامك</p>
        <hr class="border-light w-25 mx-auto opacity-50" />
        <p class="mb-1 small">&copy; @DateTime.Now.Year رواسي للتطوير العقاري - جميع الحقوق محفوظة</p>
        <p class="small mb-0">01104232214 | 01104232291</p>
    </footer>

    <a href="https://wa.me/201104232214" target="_blank" rel="noopener" class="whatsapp-float" title="تواصل معنا عبر واتساب">
        WhatsApp
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>