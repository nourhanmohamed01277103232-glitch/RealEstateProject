@model RealEstateProject.Models.JournalEntry
@{
    ViewData["Title"] = "تعديل قيد";
    var accounts = ViewBag.Accounts as List<RealEstateProject.Models.AccountDropdownItem>;
}

<section class="container py-5">
    <h2 class="fw-bold mb-4">تعديل القيد: @Model.EntryNumber</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="oldEntryNumber" value="@Model.EntryNumber" />

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">رقم القيد</label>
                <input asp-for="EntryNumber" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">التاريخ</label>
                <input asp-for="TransactionDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">المرجع</label>
                <input asp-for="Reference" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">البيان العام</label>
            <input asp-for="Description" class="form-control" />
        </div>

        <h5 class="fw-bold mt-4 mb-3">أطراف القيد (مدين / دائن)</h5>

        <div class="table-responsive">
            <table class="table table-bordered" id="linesTable">
                <thead class="table-primary">
                    <tr>
                        <th>الحساب</th>
                        <th>البيان</th>
                        <th>مدين</th>
                        <th>دائن</th>
                        <th>حذف</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td>
                                <select name="Lines[@i].AccountID" class="form-select" required>
                                    <option value="">-- اختر الحساب --</option>
                                    @if (accounts != null)
                                    {
                                        foreach (var acc in accounts)
                                        {
                                            <option value="@acc.AccountID" selected="@(acc.AccountID == Model.Lines[i].AccountID)">
                                                @acc.AccountCode - @acc.AccountName
                                            </option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control" /></td>
                            <td><input name="Lines[@i].Debit" value="@Model.Lines[i].Debit" type="number" step="0.01" class="form-control debit-input" /></td>
                            <td><input name="Lines[@i].Credit" value="@Model.Lines[i].Credit" type="number" step="0.01" class="form-control credit-input" /></td>
                            <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">×</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <button type="button" class="btn btn-secondary mb-3" onclick="addRow()">+ إضافة طرف</button>

        <div class="alert alert-info">
            <strong>إجمالي المدين:</strong> <span id="totalDebit">0.00</span> |
            <strong>إجمالي الدائن:</strong> <span id="totalCredit">0.00</span> |
            <strong>الفرق:</strong> <span id="difference">0.00</span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">حفظ التعديلات</button>
            <a asp-action="Index" class="btn btn-secondary">رجوع</a>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        let rowIndex = @Model.Lines.Count;

        function addRow() {
            const tbody = document.querySelector('#linesTable tbody');
            const accountsHtml = `@Html.Raw(string.Join("", (accounts ?? new List<RealEstateProject.Models.AccountDropdownItem>()).Select(a => $"<option value='{a.AccountID}'>{a.AccountCode} - {a.AccountName}</option>")))`;

            const row = `
                <tr>
                    <td>
                        <select name="Lines[${rowIndex}].AccountID" class="form-select" required>
                            <option value="">-- اختر الحساب --</option>
                            ${accountsHtml}
                        </select>
                    </td>
                    <td><input name="Lines[${rowIndex}].Description" class="form-control" /></td>
                    <td><input name="Lines[${rowIndex}].Debit" type="number" step="0.01" class="form-control debit-input" value="0" /></td>
                    <td><input name="Lines[${rowIndex}].Credit" type="number" step="0.01" class="form-control credit-input" value="0" /></td>
                    <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">×</button></td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', row);
            rowIndex++;
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            calculateTotals();
        }

        function calculateTotals() {
            let totalDebit = 0, totalCredit = 0;
            document.querySelectorAll('.debit-input').forEach(i => totalDebit += parseFloat(i.value) || 0);
            document.querySelectorAll('.credit-input').forEach(i => totalCredit += parseFloat(i.value) || 0);
            document.getElementById('totalDebit').innerText = totalDebit.toFixed(2);
            document.getElementById('totalCredit').innerText = totalCredit.toFixed(2);
            document.getElementById('difference').innerText = (totalDebit - totalCredit).toFixed(2);
        }

        document.addEventListener('input', calculateTotals);
        calculateTotals();
    </script>
}