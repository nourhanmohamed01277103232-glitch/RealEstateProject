@model List<RealEstateProject.Models.CompanyExpense>
@{
    ViewData["Title"] = "مصروفات الشركة";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold section-title mb-0">مصروفات الشركة</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Expenses" asp-action="Create" class="btn btn-primary">+ إضافة مصروف</a>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>الوصف</th>
                    <th>المبلغ</th>
                    <th>التاريخ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Description</td>
                        <td>@e.Amount.ToString("N2") ج.م</td>
                        <td>@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                        <td class="d-flex gap-2">
                            <a asp-controller="Expenses" asp-action="Details" asp-route-id="@e.ExpenseID" class="btn btn-outline-primary btn-sm">توزيع الحصص</a>

                            @if (User.IsInRole("Admin"))
                            {
                                <form asp-controller="Expenses" asp-action="Delete" asp-route-id="@e.ExpenseID" method="post" onsubmit="return confirm('متأكدة من الحذف؟');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">حذف</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>