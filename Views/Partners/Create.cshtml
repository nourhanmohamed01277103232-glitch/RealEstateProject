@model RealEstateProject.Models.Partner
@{
    ViewData["Title"] = "إضافة شريك";
}

<section class="container py-5" style="max-width:600px;">
    <h2 class="fw-bold mb-4 section-title">إضافة شريك جديد</h2>

    <form asp-controller="Partners" asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">الاسم</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">نسبة الملكية (%)</label>
            <input asp-for="OwnershipPercentage" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">رقم التليفون</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">تاريخ الانضمام</label>
            <input asp-for="JoinDate" type="date" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary w-100">حفظ</button>
        <a asp-controller="Partners" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">إلغاء</a>
    </form>
</section>