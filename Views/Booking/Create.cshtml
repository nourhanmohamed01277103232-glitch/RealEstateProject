@model RealEstateProject.Models.Booking
@{
    ViewData["Title"] = "احجز وحدتك";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="fw-bold text-center mb-4">🏠 احجز وحدتك</h2>

                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success">@ViewBag.Success</div>
                    }

                    @if (ViewBag.PropertyTitle != null)
                    {
                        <div class="alert alert-info">
                            <strong>الوحدة المختارة:</strong> @ViewBag.PropertyTitle
                            <br />
                            <strong>السعر:</strong> @(((decimal)ViewBag.PropertyPrice).ToString("N0")) ج.م
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">الاسم الكامل *</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">رقم التليفون *</label>
                            <input asp-for="Phone" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الإيميل</label>
                            <input asp-for="Email" type="email" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">نوع الوحدة</label>
                            <select asp-for="UnitType" class="form-select">
                                <option value="">-- اختر --</option>
                                <option value="شقة">شقة</option>
                                <option value="مشروع">مشروع</option>
                                <option value="جراج">جراج</option>
                                <option value="أرض">أرض</option>
                                <option value="مكتب">مكتب</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">المبلغ المقدم (ج.م)</label>
                            <input asp-for="DownPayment" type="number" step="0.01" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">إرسال الحجز</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>