@{
    ViewData["Title"] = "تسجيل الدخول";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="fw-bold text-center mb-4">🔒 تسجيل الدخول</h2>

                    <form asp-action="Login" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label">كلمة السر</label>
                            <input type="password" name="password" class="form-control" required autofocus autocomplete="new-password" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">دخول</button>
                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>