@model List<RealEstateProject.Models.CapitalMovement>
@{
    ViewData["Title"] = "حركات رأس المال";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold section-title mb-0">حركات رأس المال</h2>
        <a asp-controller="CapitalMovements" asp-action="Create" class="btn btn-primary">+ إضافة حركة</a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>الشريك</th>
                    <th>النوع</th>
                    <th>المبلغ</th>
                    <th>التاريخ</th>
                    <th>ملاحظات</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.PartnerName</td>
                        <td>
                            <span class="badge @(m.MovementType == "إيداع" ? "bg-success" : "bg-danger")">@m.MovementType</span>
                        </td>
                        <td>@m.Amount.ToString("N2") ج.م</td>
                        <td>@m.MovementDate.ToString("yyyy-MM-dd")</td>
                        <td>@m.Notes</td>
                        <td>
                            <form asp-controller="CapitalMovements" asp-action="Delete" asp-route-id="@m.MovementID" method="post" onsubmit="return confirm('متأكدة من الحذف؟');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>