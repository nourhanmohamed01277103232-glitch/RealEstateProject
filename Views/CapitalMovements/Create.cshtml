
@model RealEstateProject.Models.CapitalMovement
@{
    ViewData["Title"] = "إضافة حركة";
}

<section class="container py-5" style="max-width:600px;">
    <h2 class="fw-bold mb-4 section-title">إضافة حركة رأس مال</h2>

    <form asp-controller="CapitalMovements" asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">الشريك</label>
            <select asp-for="PartnerID" class="form-select" required>
                <option value="">اختاري الشريك</option>
                @foreach (var p in (List<RealEstateProject.Models.Partner>)ViewBag.Partners)
                {
                    <option value="@p.PartnerID">@p.Name</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">النوع</label>
            <select asp-for="MovementType" class="form-select">
                <option value="إيداع">إيداع</option>
                <option value="سحب">سحب</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">المبلغ</label>
            <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">التاريخ</label>
            <input asp-for="MovementDate" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">ملاحظات</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-primary w-100">حفظ</button>
        <a asp-controller="CapitalMovements" asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">إلغاء</a>
    </form>
</section>